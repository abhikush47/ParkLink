# ParkLink Environment Configuration

# Public Supabase API Settings (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Base URL (Used for QR code generation and deep links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Notification Gateways (future integrations)
# RESEND_API_KEY=
# WHATSAPP_API_TOKEN=
